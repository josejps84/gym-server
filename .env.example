# Copy to .env for local development. In Cloud Run these are env vars / Secret Manager secrets.

# Local: docker compose up -d. Supabase: Project Settings > Database > Connection string >
# "Session pooler" (IPv4), changing the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://gym:gym@localhost:5433/gym
# true only for the transaction pooler (port 6543)
DB_TRANSACTION_POOLER=false
DB_POOL_SIZE=5

# Project Settings > API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret: never ship it in the app. Used for signed avatar uploads and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
AVATARS_BUCKET=avatars

CORS_ORIGINS=["https://localhost","capacitor://localhost","http://localhost:5173","https://gym.josepineros.dev"]
RATE_LIMIT_PER_MINUTE=120

# Email through Resend (resend.com > API Keys). Without a key nothing is sent.
RESEND_API_KEY=
MAIL_FROM=Gym <no-reply@example.com>
# Gets an email for every user report.
REPORTS_EMAIL=
# Shown as the data controller in /privacy.
PRIVACY_CONTACT=
